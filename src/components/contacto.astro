---
import ContentSection from "~/components/content-section.astro";
const { site } = Astro;
---

<ContentSection title="Contact" id="contact">
  <span slot="lead">
    Looking for a new way to make money online? 💻✨<br>
    Love to dance and show off your personality? 🍑💃<br>
    Whether you’re on OnlyFans or just looking for a flexible way to earn, TWERK.DANCE lets you go live, grow your fanbase, and get paid to do what you love. No agents. No gatekeepers. Just you, your audience, and your vibe. 💕📲 <br>
    Get tips, grow your following, and join a supportive community of bold, confident women turning their energy into income. 💸✨<br>
    Apply now and start building your brand — one move at a time. 🚀<br>
  </span>

  <section>
    <div class="mx-auto px-4 py-8 sm:min-w-96 md:min-w-176 lg:py-6">
      <form
        class="space-y-8"
        accept-charset="utf-8"
        name="contact-form"
        action="https://formsubmit.co/ppv@twerk.dance"
        method="post"
      >
        <div class="flex-row lg:flex lg:gap-x-4">
          <div class="w-full lg:mb-6">
            <label for="name" class="mb-2 block text-sm font-medium">
              Name
            </label>
            <input
              type="text"
              id="name"
              name="name"
              class="block w-full rounded-lg border border-input bg-contactInput p-2.5 text-sm text-default placeholder-default shadow-sm"
              placeholder="Your Telegram username"
              required
            />
          </div>
          <div class="w-full lg:mb-6">
            <label for="email" class="mb-2 block text-sm font-medium">
              Email
            </label>
            <input
              type="email"
              id="email"
              name="email"
              class="block w-full rounded-lg border border-input bg-contactInput p-2.5 text-sm text-default placeholder-default shadow-sm"
              placeholder="my@emailaddy.com"
              required
            />
          </div>
        </div>

        <div class="sm:col-span-2">
          <label for="message" class="mb-2 block text-sm font-medium">
            Your Message
          </label>
          <textarea
            id="message"
            name="message"
            rows="6"
            minlength="10"
            class="block w-full min-h-24 max-h-60 rounded-lg border border-input bg-contactInput p-2.5 text-sm text-default placeholder-default shadow-sm"
            placeholder="Show us why you'd make a great TWERK.DANCE star!"
            required
          ></textarea>
        </div>

        <button
          type="submit"
          class="min-w-72 sm:min-w-96 md:min-w-176 rounded-lg bg-gradient-to-br from-yellow-500 to-yellow-600 px-5 py-3 text-center text-sm font-medium text-white duration-300 hover:scale-105 focus:outline-none focus:ring-4"
        >
          Send Message
        </button>

        <!-- FormSubmit.co hidden inputs -->
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_next" value={site} />
        <input type="hidden" name="_template" value="box" />
        <input type="hidden" name="_cc" value="ppv@twerk.dance" />
      </form>
    </div>
  </section>
</ContentSection>
